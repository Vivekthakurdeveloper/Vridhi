# Application
APP_ENV=development
APP_NAME=vridhi-api
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8443
PORT=8000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql+psycopg://vridhi:vridhi@localhost:5432/vridhi

# Auth / sessions
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_COOKIE_NAME=vridhi_session
SESSION_TTL_DAYS=14
PASSWORD_RESET_TTL_HOURS=1
EMAIL_VERIFY_TTL_HOURS=24
INVITE_TTL_DAYS=7
COOKIE_SECURE=false

# Google OAuth (optional locally; required for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/v1/auth/google/callback

# Email (Phase 1: log-only provider unless SMTP set)
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@vridhi.ai

# ---------------------------------------------------------------------------
# Phase B — all knobs are configurable via env
# ---------------------------------------------------------------------------

# Feature flags
FILE_UPLOAD_ENABLED=true
GOOGLE_DRIVE_ENABLED=true
GMAIL_ENABLED=true
AI_QUERY_ENABLED=true
SEARCH_ENABLED=true
USAGE_ENABLED=false
BILLING_ENABLED=false
SSO_ENABLED=false

# Upload limits
UPLOAD_MAX_BYTES=52428800
UPLOAD_ALLOWED_EXTENSIONS=pdf,docx,xlsx,pptx,txt,csv
UPLOAD_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv,application/octet-stream
DOCUMENT_PREVIEW_MAX_CHARS=4000

# Backends: storage=s3|filesystem  queue=sqs|db  search=opensearch|noop
# Local without LocalStack/OpenSearch:
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_PATH=/tmp/vridhi-storage
QUEUE_BACKEND=db
SEARCH_BACKEND=noop

# Object storage (used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=vridhi-documents
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PREFIX=tenants

# SQS + DLQ (used when QUEUE_BACKEND=sqs)
SQS_ENDPOINT_URL=http://localhost:4566
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=vridhi-ingest
SQS_DLQ_NAME=vridhi-ingest-dlq
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT=300
SQS_MAX_MESSAGES=5
INGEST_MAX_ATTEMPTS=5

# OpenSearch (used when SEARCH_BACKEND=opensearch)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=vridhi-chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120
CHUNK_MIN_CHARS=40

# Embeddings: hash (local, no API key) | openai
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=hash-v1
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

# Worker
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Phase C — Search + Ask RAG (all configurable)
# ---------------------------------------------------------------------------
AI_QUERY_ENABLED=true
SEARCH_ENABLED=true
RETRIEVAL_TOP_K=40
RETRIEVAL_BM25_SIZE=40
RETRIEVAL_KNN_SIZE=40
RETRIEVAL_RRF_K=60
RERANK_TOP_K=8
MIN_CITATION_SCORE=0.08
SEARCH_PREVIEW_CHARS=280
CHAT_MAX_CONTEXT_CHARS=12000
CHAT_STREAM_ENABLED=true
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
NO_ANSWER_PHRASE=I don't know based on the available company knowledge.

# ---------------------------------------------------------------------------
# Phase D — Google Drive
# mock = local fixture sync (no Google credentials); oauth = real Drive
# ---------------------------------------------------------------------------
GOOGLE_DRIVE_MODE=mock
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/v1/connections/google_drive/oauth/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email
TOKEN_BACKEND=fernet
TOKEN_ENCRYPTION_KEY=vridhi-dev-fernet-key-change-me-32b!
DRIVE_SYNC_PAGE_SIZE=100
DRIVE_MAX_FILE_BYTES=52428800

# ---------------------------------------------------------------------------
# Phase E — Gmail
# mock = local fixture mailbox (no Google credentials); oauth = real Gmail
#
# Real Gmail additionally requires, in the Google Cloud Console:
#   1. Gmail API enabled on the project
#   2. gmail.readonly listed on the OAuth consent screen's *Data Access* page
#      (declaring it in the auth URL alone yields a silent 403 at call time)
#   3. test users added under Audience (gmail.readonly is a restricted scope)
#   4. GOOGLE_GMAIL_REDIRECT_URI added to the client's redirect URIs
# Reuses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
# ---------------------------------------------------------------------------
GMAIL_MODE=mock
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/v1/connections/gmail/oauth/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/userinfo.email
GMAIL_SYNC_PAGE_SIZE=50
GMAIL_MAX_ATTACHMENT_BYTES=26214400
GMAIL_QUERY=has:attachment
GMAIL_ALLOWED_MIME=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/csv

# ---------------------------------------------------------------------------
# Phase F — Enterprise Google Workspace auth foundation (Domain-Wide Delegation)
# mock = fixture domain, no real Google calls; live = real per-tenant service account
# ---------------------------------------------------------------------------
WORKSPACE_ENTERPRISE_MODE=mock
WORKSPACE_ENTERPRISE_SCOPES=https://www.googleapis.com/auth/admin.directory.user.readonly
